# LLM model identifiers (LiteLLM format)
MODEL_WRITER=gemini/gemini-2.5-flash-preview-05-20
MODEL_CLASSIFIER=gemini/gemini-2.5-flash-preview-05-20
LLM_TEMPERATURE=0.1

# Pipeline defaults
UPWORK_JOB_TITLE=AI Agent Developer
UPWORK_NUM_JOBS=10
UPWORK_DEFAULT_RATE=$85.00

# API server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Provider keys (optional depending on your model choice)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# TAVILY_API_KEY=